{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cloudpath.dev/plugin-manifest/v1alpha1",
  "title": "PluginManifest",
  "description": "插件仓库根 plugin.yaml 的机器可读 schema（A7 Registry 校验用）。",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "protocol", "entrypoint"],
  "properties": {
    "apiVersion": {"const": "plugins.cloudpath.dev/v1alpha1"},
    "kind": {"enum": ["Driver", "Application", "Connector"]},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "protocol": {"type": "integer", "description": "RPC 协议版本"},
    "entrypoint": {"type": "string"},
    "compatibility": {"type": "object", "properties": {"core": {"type": "string"}}},
    "permissions": {
      "type": "object",
      "properties": {
        "hardware": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}},
        "filesystem": {"type": "array", "items": {"type": "string"}},
        "secrets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "contributes": {
      "type": "object",
      "description": "Typed contributions declared by the plugin; ids are stable and distinct from the plugin id. Unknown properties are ignored (current compatibility policy).",
      "properties": {
        "drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "description": "Stable driver contribution id (distinct from the plugin id)."},
              "title": {"type": "string"},
              "descriptor": {"type": "string"},
              "configSchema": {"type": "string"},
              "discovery": {"type": "string"},
              "capabilityCatalog": {"type": "string"}
            }
          }
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "description": "Stable application contribution id (distinct from the plugin id)."},
              "title": {"type": "string"},
              "requirements": {"type": "array", "items": {"type": "object"}}
            }
          }
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "description": "Stable connector contribution id (distinct from the plugin id)."},
              "title": {"type": "string"},
              "direction": {"type": "string"},
              "host": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

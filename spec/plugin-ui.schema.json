{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cloudpath.dev/plugin-ui/v1",
  "title": "PluginUIContribution",
  "description": "Declarative UI contribution for an Application or Driver plugin. Core validates and renders allowlisted sections; arbitrary scripts are not allowed.",
  "type": "object",
  "required": ["apiVersion"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": 1},
    "navigation": {"$ref": "#/$defs/navigation"},
    "pages": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/page"}},
    "device": {"$ref": "#/$defs/device"}
  },
  "$defs": {
    "navigation": {
      "type": "object",
      "required": ["title", "route"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 40},
        "i18n": {
          "type": "object",
          "description": "Optional locale -> navigation title map. Legacy title remains the default.",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "icon": {"type": "string", "maxLength": 40},
        "order": {"type": "integer", "minimum": 0, "maximum": 999},
        "route": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "visibility": {"enum": ["instance-enabled", "always"]}
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "maxLength": 240},
        "i18n": {
          "type": "object",
          "description": "Optional locale -> page title map. Legacy title remains the default.",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "sections": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/section"}}
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "sections": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/section"}}
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["status", "metrics", "form", "actions", "records", "timeline", "table", "schedule", "chart", "markdown", "diagnostics", "custom"]},
        "title": {"type": "string", "maxLength": 80},
        "description": {"type": "string", "maxLength": 240},
        "emptyText": {"type": "string", "maxLength": 160},
        "i18n": {
          "type": "object",
          "description": "Optional locale -> section text map. Use <locale>.description and <locale>.emptyText for those fields.",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "source": {"enum": ["instance", "bindings", "jobs", "manual-jobs", "records", "config", "device", "device-actions", "diagnostics", "state", "events"]},
        "recordType": {"type": "string", "maxLength": 64},
        "presentation": {"enum": ["list", "timeline", "table", "cards"]},
        "text": {"type": "string", "maxLength": 4000},
        "entry": {"type": "string", "maxLength": 240},
        "scopes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["instance.read", "jobs.run", "records.read", "bindings.read", "config.write"]}},
        "fields": {"type": "array", "maxItems": 64, "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}

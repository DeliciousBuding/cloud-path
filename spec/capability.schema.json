{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cloudpath.dev/capability/v1alpha1",
  "title": "Capability",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "capabilities.cloudpath.dev/v1alpha1"},
    "kind": {"const": "Capability"},
    "metadata": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^.+\\/capability\\/.+@\\d+$"},
        "version": {"type": "integer"},
        "title": {"type": "string"},
        "i18n": {
          "type": "object",
          "description": "可选 locale -> title 映射；旧 title 仍是默认值。",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Property"}},
        "events": {"type": "object", "additionalProperties": {"$ref": "#/definitions/EventDecl"}},
        "actions": {"type": "object", "additionalProperties": {"$ref": "#/definitions/ActionDecl"}},
        "presentation": {"type": "object"}
      }
    }
  },
  "definitions": {
    "Property": {
      "type": "object",
      "description": "冻结字段；WebUI 的 widget/min/max 等旧提示不属于本 schema。",
      "properties": {
        "type": {"type": "string"},
        "unit": {"type": "string", "description": "统一单位代码，不得用本地化文本"},
        "access": {"enum": ["read", "write", "readwrite"]},
        "quality": {"type": "array", "items": {"enum": ["good", "uncertain", "bad", "unavailable"]}}
      }
    },
    "EventDecl": {
      "type": "object",
      "description": "冻结字段；WebUI 的 title/description 旧展示提示不属于本 schema。",
      "properties": {"payloadSchema": {"type": "object"}}
    },
    "ActionDecl": {
      "type": "object",
      "description": "冻结字段；WebUI 的 command/primary 旧兼容字段不属于本 schema。",
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "i18n": {
          "type": "object",
          "description": "可选 locale -> action 文本映射。title 用 <locale>；description 用 <locale>.description；旧字段仍是默认值。",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "inputSchema": {"type": "object"},
        "destructive": {"type": "boolean", "description": "破坏性动作需要显式确认，不替代权限或设备侧校验"},
        "confirmation": {"type": "string", "description": "执行前展示的确认说明"}
      }
    }
  }
}
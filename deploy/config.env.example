# 复制为 deploy/.env 后供 compose 使用（deploy/.env 已被根 .gitignore 忽略）。
# 不要把真实令牌提交到仓库；生成示例：python -c "import secrets; print(secrets.token_hex(32))"
# 公网部署请把 CLOUDPATH_REQUIRE_AUTH 设为 true，并设置 CLOUDPATH_ALLOWED_ORIGINS。
CLOUDPATH_VERSION=dev
CLOUDPATH_BIND=127.0.0.1:8080
CLOUDPATH_TOKEN=change-me-to-a-long-random-token
CLOUDPATH_REQUIRE_AUTH=false
CLOUDPATH_ALLOWED_ORIGINS=console.example.com
CLOUDPATH_RETENTION_DAYS=30
CLOUDPATH_CMD_RATE=20
CLOUDPATH_LOGIN_RATE=5
CLOUDPATH_SESSION_DAYS=7
CLOUDPATH_LOG=info
CLOUDPATH_LOG_FORMAT=json

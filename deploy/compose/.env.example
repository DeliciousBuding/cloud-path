# =============================================================================
# CloudPath compose 部署环境变量模板
# -----------------------------------------------------------------------------
# 复制为 compose.env 后填写；绝不把真实令牌提交进 git。
# 生成强随机值：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# =============================================================================

# ---- 镜像 / 构建 -------------------------------------------------------------
CLOUDPATH_IMAGE=cloudpath:local
CLOUDPATH_VERSION=dev            # 与 git tag 一致，例如 v0.1.0

# ---- 日志 --------------------------------------------------------------------
CLOUDPATH_LOG=info
CLOUDPATH_LOG_FORMAT=json

# ---- 安全凭据（必须改）-------------------------------------------------------
# 共享服务令牌：edge / 脚本鉴权，等价 default-tenant admin
CLOUDPATH_TOKEN=change-me-to-a-long-random-token
# 一次性首装令牌：非回环来源执行 /api/auth/setup 必带，首装成功即失效
CLOUDPATH_SETUP_TOKEN=change-me-another-random-token

# ---- 浏览器 WS 来源白名单（精确 host，无协议前缀）------------------------------
# 公网必须与本机访问域名一致；留空 = 开发策略（同源+localhost），启动会告警。
CLOUDPATH_ALLOWED_ORIGINS=cloudpath.example.com

# ---- 服务参数（可选，注释为内置默认）-------------------------------------------
CLOUDPATH_RETENTION_DAYS=30
CLOUDPATH_CMD_RATE=20
CLOUDPATH_LOGIN_RATE=5
CLOUDPATH_SESSION_DAYS=7

# ---- L0 本机绑定（docker-compose.yml 用；公网形态忽略）------------------------
# 保持 127.0.0.1:8080，勿改成 0.0.0.0 直出公网。
CLOUDPATH_BIND=127.0.0.1:8080

# ---- L2 公网 nginx（docker-compose.public.yml 用）-----------------------------
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# 对外访问域名（会写进 nginx server_name；证书放 deploy/compose/certs/）
PUBLIC_SERVER_NAME=cloudpath.example.com

# 说明：CLOUDPATH_REQUIRE_AUTH 在公网形态固定为 true；TRUSTED_PROXIES 固定为
# 172.28.0.10/32（nginx 容器固定 IP），均无需在此配置。

# CloudPath Server environment template — VARIABLE NAMES ONLY, NO VALUES.
#
# Copy this file, fill it in on the deployment host (never in the repository),
# and install it as a root-owned 0600 file:
#
#   sudo install -D -m 0600 -o root -g root /path/to/filled.env /etc/cloudpath/cloudpath-server.env
#
# systemd reads it through EnvironmentFile=-/etc/cloudpath/cloudpath-server.env
# (see deploy/systemd/cloudpath-server.service). An empty value is equivalent to
# "unset": the server falls back to its built-in default, so leaving optional
# keys empty is safe.
#
# Generate strong random values (do not reuse hostnames, project names or short
# passwords):
#   openssl rand -hex 32                              # Linux / macOS
#   python -c "import secrets; print(secrets.token_hex(32))"   # anywhere
#
# The filled file must never be committed, pasted into an issue, or copied into
# a browser-visible location. Rotate immediately on suspected exposure.

# ---- shared service token (legacy, equivalent to default-tenant admin) ------
# Used by Edge clients and automation. Prefer per-tenant tokens created through
# POST /api/tokens for day-2 operation; this key remains for bootstrap.
CLOUDPATH_TOKEN=

# ---- one-time first-install token ------------------------------------------
# Required for POST /api/auth/setup from a NON-loopback source. Consumed on
# first successful setup. NOTE: a reverse proxy on the same host makes the TCP
# source loopback, so complete the account setup from the host itself BEFORE
# exposing the site (see deploy/README.md step 5).
CLOUDPATH_SETUP_TOKEN=

# ---- public web origin allowlist -------------------------------------------
# Comma-separated host patterns the browser WebSocket may be opened from,
# e.g. the public console hostname (no scheme prefix). Must match the site
# served by the reverse proxy, including the port when it is not 443.
# Leaving this empty selects the development policy (same-origin + localhost)
# and the server logs a warning at startup.
CLOUDPATH_ALLOWED_ORIGINS=

# ---- force authentication even before any account exists --------------------
# true|false. Set to true for a public deployment that has not completed
# account setup yet. After the first admin exists, account mode is enforced
# automatically.
CLOUDPATH_REQUIRE_AUTH=

# ---- trusted reverse-proxy CIDRs -------------------------------------------
# Comma-separated CIDRs whose X-Forwarded-For / X-Real-IP headers are believed.
# For an on-host nginx reverse proxy this is the loopback address; add the CDN
# or upstream proxy ranges only when they connect directly to this port.
# Without this, client IPs in audit records and login rate limiting are the
# proxy address instead of the real client.
CLOUDPATH_TRUSTED_PROXIES=

# ---- Application Plugin Host (optional; disabled by default) ----------------
# CLOUDPATH_APP_HOST: true|false (default false). When disabled, the three path
# settings below are ignored. Enable it only after Application plugins have been
# installed in CLOUDPATH_APP_PLUGINS_DIR with the matching lockfile.
# The path defaults are relative to WorkingDirectory (/var/lib/cloudpath in the
# systemd unit): data/app-plugins.d, data/app-plugins.lock, data/app-host-state.
# CLOUDPATH_APP_PLUGINS_DIR must use the layout written by `cloudpath plugin
# install`; CLOUDPATH_APP_LOCK must be its matching lockfile and contain the
# installed plugin entries. Plugin executables must match the host OS/arch and
# be readable/executable by the cloudpath service account. Keep the plugin
# install directory, lockfile and state directory under /var/lib/cloudpath
# (the unit's only writable path), or update the unit before using another
# location.
# CLOUDPATH_APP_STATE_DIR must be writable for AppHost bookkeeping; it is not
# the desired-state SSOT.
CLOUDPATH_APP_HOST=
CLOUDPATH_APP_PLUGINS_DIR=
CLOUDPATH_APP_LOCK=
CLOUDPATH_APP_STATE_DIR=

# ---- retention and rate limits (optional; defaults shown in comments) -------
# Event / terminal-command retention in days (default 30).
CLOUDPATH_RETENTION_DAYS=
# Commands per device per minute (default 20).
CLOUDPATH_CMD_RATE=
# Login attempts per client IP per minute (default 5).
CLOUDPATH_LOGIN_RATE=
# Session lifetime in days (default 7).
CLOUDPATH_SESSION_DAYS=

# ---- logging (optional; the unit already sets info + json) ------------------
CLOUDPATH_LOG=
CLOUDPATH_LOG_FORMAT=
